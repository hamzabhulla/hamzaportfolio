# Required for absolute canonical URLs, sitemap.xml, and production social previews.
# Use the permanent production origin only, e.g. https://your-domain.com
NEXT_PUBLIC_SITE_URL=

# Optional overrides for the default Instagram and Facebook profile links in lib/social-links.ts.
# Leave blank to keep the current profile links.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=

# Optional Google Search Console HTML-tag verification content value.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Confirm this is your real contact inbox before deployment.
NEXT_PUBLIC_CONTACT_EMAIL=
